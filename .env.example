# Calendly (optional — falls back to a built-in date/time picker if unset)
NEXT_PUBLIC_CALENDLY_URL=

# Facebook Pixel ID (Meta Events Manager > your pixel > Settings)
NEXT_PUBLIC_FB_PIXEL_ID=

# Google tag ID — Google Ads conversion ID (AW-XXXXXXXXX) and/or GA4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GTAG_ID=

# Optional second Google tag ID, if you need both Google Ads AND GA4 at once
NEXT_PUBLIC_GTAG_SECONDARY_ID=
